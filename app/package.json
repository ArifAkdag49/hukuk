    "@react-native/jest-preset": "^0.86.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "cross-env": "^10.1.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14"
  },
  "overrides": {
    "react-dom": "19.2.3"
